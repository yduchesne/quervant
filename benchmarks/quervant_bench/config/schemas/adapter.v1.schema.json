{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quervant-bench:contract:adapter:v1",
  "title": "Quervant benchmark adapter capability manifest",
  "description": "Declarative capability manifest and interface seam. No adapter is instantiated or measured in BM-01.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "adapter_id",
    "adapter_version",
    "engine_id",
    "operations",
    "cache_regimes",
    "oracle_semantics_id",
    "build_identity",
    "measurement_envelope",
    "timeouts"
  ],
  "properties": {
    "kind": { "const": "adapter" },
    "schema_version": { "const": 1 },
    "adapter_id": { "$ref": "#/$defs/slug" },
    "adapter_version": { "$ref": "#/$defs/positiveInt" },
    "engine_id": { "$ref": "#/$defs/slug" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "cache_regimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cacheRegime" }
    },
    "oracle_semantics_id": { "$ref": "#/$defs/slug" },
    "build_identity": {
      "oneOf": [
        { "$ref": "#/$defs/syntheticBuildIdentity" },
        { "$ref": "#/$defs/sourceBuildIdentity" }
      ]
    },
    "measurement_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "direction"],
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["nanoseconds", "operations-per-second", "bytes"]
        },
        "direction": {
          "type": "string",
          "enum": ["lower-is-better", "higher-is-better"]
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup_ms", "operation_ms", "cleanup_ms"],
      "properties": {
        "setup_ms": { "$ref": "#/$defs/positiveInt" },
        "operation_ms": { "$ref": "#/$defs/positiveInt" },
        "cleanup_ms": { "$ref": "#/$defs/positiveInt" }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "search",
        "index",
        "mutation",
        "compaction",
        "storage-read",
        "storage-write"
      ]
    },
    "cacheRegime": {
      "type": "string",
      "enum": ["warm", "process-cold", "cache-cold", "not-applicable"]
    },
    "syntheticBuildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "synthetic" }
      }
    },
    "sourceBuildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_digest", "executable_digest"],
      "properties": {
        "kind": { "const": "source-and-binary" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "executable_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_pr": { "type": "string", "maxLength": 256 },
        "historical_label": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
